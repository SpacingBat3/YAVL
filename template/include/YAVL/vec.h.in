#ifndef @YAVL_C_NAMESPACE_UPPER_@VEC_H
#define @YAVL_C_NAMESPACE_UPPER_@VEC_H
#pragma clang final(@YAVL_C_NAMESPACE_UPPER_@VEC_H)
#include <stddef.h>
#include <stdbool.h>

/** @defgroup ERR Error handling API
 *
 * @brief Error handling and reporting API,
 * allowing for recovery on error, cleanup
 * and additional safety guards before data
 * access.
 *
 * @{
 */

/// @brief Operation result codes
typedef enum : char {
  /// @brief Out-of-memory, allocator failures
  @YAVL_C_NAMESPACE_UPPER_@VEC_RES_OOM = -2,
  /// @brief Null pointer exception
  @YAVL_C_NAMESPACE_UPPER_@VEC_RES_NULL,
  /// @brief Operation success
  @YAVL_C_NAMESPACE_UPPER_@VEC_RES_OK = 0,
  /// @brief Generic operation failure
  @YAVL_C_NAMESPACE_UPPER_@VEC_RES_FAIL,
} @YAVL_C_NAMESPACE_@vec_res_t;

/**
 * @brief A return package which contains both result code
 * and data.
 */
typedef struct {
  /// @brief Operation status (error code)
  @YAVL_C_NAMESPACE_@vec_res_t status;
  /// @brief Data pointer, might be NULL on fatal failures.
  void *const mem;
} @YAVL_C_NAMESPACE_@vec_errorable_t;

/** @} */ // ERR

/** @defgroup VEC Vector API
 *
 * @brief Vector API definition
 *
 * @{
 */

/**
 * @brief Type-agnostic vector definition.
 *
 * It stores data on heap, although the metadata can be stored
 * wherever, with stack being recommended when vector is being
 * used as an intermediate type for array generation.
 * The metadata has to be detached from data, as memory usage
 * for data is assumed to be very volatile and it is preffered
 * to drop metadata when converting to the regular C arrays.
 *
 * @note Read-write and manual structure definition is currently
 * discouraged and may cause undefined behaviour. With that being
 * said, metadata needs to be allocated in read-write memory space.
 * In the future, access to struct might be greatly limited to
 * limit unsafe access to vector.
 */
typedef struct {
  /// @brief Pointer to data array.
  ///
  /// Raw access is considered unsafe and requires additional
  /// memory checks done automatically by the library.
  void* data;
  /// @brief Current data allignment (size of
  /// individual vector element in `unsigned char`s).
  size_t allign;
  /// @brief Current data length.
  ///
  /// Should be used for array bounds.
  size_t len;
  /// @brief Currently reserved data.
  ///
  /// Should be used for memory calculations.
  size_t reservd;
} @YAVL_C_NAMESPACE_@vec_t;

/// @def @YAVL_C_NAMESPACE_UPPER_@VEC_T_ALLOCATOR
/// @brief Allocator for @YAVL_C_NAMESPACE_@vec_t
#define @YAVL_C_NAMESPACE_UPPER_@VEC_T_ALLOCATOR ((@YAVL_C_NAMESPACE_@vec_t){})

/**
 * @brief Initializes a new vector. Frees memory if it is already allocated.
 *
 * @param vec An allocated vector metadata memory space.
 * @param data_align A (maximum) size of element to store.
 * @param data_reserv Default reservation to avoid frequent reallocations.
 *
 * @return Operation status.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_init(@YAVL_C_NAMESPACE_@vec_t *const vec,size_t data_align,size_t data_reserv);
/**
 * @brief Converts given statically-sized array to the dynamic ones.
 *
 * The created vector is fully-fitted to the array, so it might be
 * required to reserve more memory for it.
 *
 * @param vec An allocated vector metadata memory space.
 * @param array Array which should be transformed to a vector.
 * @param allignment Array allignment, ex. `sizeof(array[0])`
 * @param length Array length (size in allignment unit).
 *
 * @return Pointer to array stored in heap. Needs to be freed via allocator at
 * some point it becomes unnecesary or no longer accesible.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_fromarray(@YAVL_C_NAMESPACE_@vec_t *const vec,void *const array, const size_t alignment,const size_t length);
/**
 * @brief Pushes data to vector.
 *
 * @param vec Fully initialized vector to push to.
 * @param data Pointer to data which should been pushed. Has to match data allignment.
 * @param num_el Number of elements in data to push into vector.
 *
 * @return Operation status.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_push(@YAVL_C_NAMESPACE_@vec_t *const vec, const void *const data, const size_t num_el);
/**
 * @brief Pops last elements out of vector. Doesn't free memory yet.
 *
 * @param vec Fully initialized vector to pop from.
 * @param num_el Number of elements in vector to pop out as array.
 *
 * @return Pointer of last element that was removed.
 */
@YAVL_C_NAMESPACE_@vec_errorable_t @YAVL_C_NAMESPACE_@vec_pop(@YAVL_C_NAMESPACE_@vec_t *const vec, const size_t num_el);
/**
 * @brief Resizes vector space to the current size.
 *
 * DO NOT USE when there's external pointer to data,
 * as `fit` will free the data on vector it points to.
 * YOU are expected to resolve conflicts like that yourself,
 * e.g. simply by copying data out of vector.
 *
 * There's also a way to test such pointer freshness on
 * vector metadata, albeit it might require synchronization
 * for multi-threaded logic to avoid race conditions.
 *
 * @param vec Fully initialized vector.
 *
 * @return Operation status (failures usually mean bad
 * allocator, as data shrinking in practice should not
 * cause OOM conditions).
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_fit(@YAVL_C_NAMESPACE_@vec_t* const vec);
/**
 * @brief Resizes memory space to the given size.
 *
 * DO NOT USE when there's external pointer to data,
 * as `scale` in case of shrinking the memory might free
 * the data on vector it points to. YOU are expected to
 * resolve conflicts like that yourself, e.g. simply by
 * copying data out of vector.
 *
 * There's also a way to test such pointer freshness on
 * vector metadata, albeit it might require synchronization
 * for multi-threaded logic to avoid race conditions.
 *
 * @param vec Fully initialized vector.
 * @param new_reservd New memory space size to use for
 * vector data, if smaller than length it will cut out
 * data.
 *
 * @return Operation status (OK/OOMs).
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_scale(@YAVL_C_NAMESPACE_@vec_t* const vec,size_t new_reservd);
/**
 * @brief Sets `offset` -th element of vector to `data`.
 *
 * @param vec Fully initialized vector.
 * @param offset Place in which write `data` to vector.
 * @param data Memory pointer with same size as vector allignment.
 *
 * @return Operation status.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_set(@YAVL_C_NAMESPACE_@vec_t* const vec, size_t offset, const void *const data);
/**
 * @brief Gets element at `offset` and stores it in `out` memory.
 *
 * @param vec Fully initialized vector.
 * @param offset Place from which get vector element to store to `out`.
 * @param out Memory pointer with same size as vector allignment.
 *
 * @return Operation status.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_get(@YAVL_C_NAMESPACE_@vec_t* const vec, size_t offset, void *const out);
/**
 * @brief Frees heap in vector and zeroes the entire object.
 *
 * @return Empty vector ready for initialization.
 */
@YAVL_C_NAMESPACE_@vec_res_t @YAVL_C_NAMESPACE_@vec_free(@YAVL_C_NAMESPACE_@vec_t* const vec);
/**
 * @brief Try to validate if the `ptr` pointer is in bounds of `vec` vector. This might be
 * useful to ensure freshness of the `ptr` and protect it against out-of-memory-bounds
 * scenarios.
 *
 * This is additional safety measure. You should still manage your memory on your own
 * for the most optimal case scenarios. NO GUARANTEES ARE MADE THIS WILL SOLVE EVERY
 * OVERFLOW, BUG OR MEMORY-RELATED ISSUES and especially be aware of multi-thread software
 * where a race condition between check and access might be happening (you might need
 * to synchronize check and access between threads).
 *
 * @param vec Fully initialized vector used for validation.
 * @param ptr Pointer to validate.
 *
 * @return Pointer correctness in regard to vector boundaries.
 */
bool @YAVL_C_NAMESPACE_@vec_chkptr(const @YAVL_C_NAMESPACE_@vec_t* const vec, const void *const ptr);
/**
 * @brief Finalizes vector, to result it in statically-sized array.
 * This allows you to drop vector metadata.
 *
 * @param vec Fully initialized vector, that will become correctly uninitialized.
 * @param final_len Where to store logical array length, required.
 *
 * @return Pointer to array stored in heap. Needs to be freed via allocator at
 * some point it becomes unnecesary or no longer accesible.
 */
@YAVL_C_NAMESPACE_@vec_errorable_t @YAVL_C_NAMESPACE_@vec_toarray(@YAVL_C_NAMESPACE_@vec_t* const vec, size_t *const final_len);

/** @} */ // VEC
#endif /* @YAVL_C_NAMESPACE_UPPER_@VEC_H */
