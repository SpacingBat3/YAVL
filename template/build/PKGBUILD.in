# Auto-generated by CMake for packaging on Arch Linux
pkgbase=yavl
pkgname=(yavl yavl-docs)
pkgver=@PROJECT_VERSION@
pkgrel=1
pkgdesc="@PROJECT_DESCRIPTION@"
arch=('x86_64' 'aarch64')
url="@PROJECT_HOMEPAGE@"
license=('@PROJECT_SPDX_LICENSE')
makedepends=('cmake' 'doxygen')
depends=('glibc')

build() {
    cmake -S "@CMAKE_CURRENT_SOURCE_DIR@" -B workdir
    cmake --build workdir
    cmake --build workdir --target YAVLDocs
}

package_yavl() {
    DESTDIR="$pkgdir" cmake --install workdir --prefix /usr
}

package_yavl-docs() {
    pkgdesc+=" (Doxygen Documentation)"
    DESTDIR="$pkgdir" cmake --install workdir --prefix /usr --component Docs
}
